{
  "name": "@repo/database",
  "version": "1.0.0",
  "scripts": {
    "db:up": "dotenv -- drizzle-kit up --dialect=postgresql",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:seed": "dotenv -- tsx seed.ts",
    "dev": "dotenv -- drizzle-kit studio"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
